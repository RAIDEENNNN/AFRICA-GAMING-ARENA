# Clan Arena local development
# Copy to .env.local when configuring real providers.

# Primary production backend target: Supabase.
# Cloudflare D1 remains temporary during migration and must not become a second source of truth.
DATABASE_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=
DIRECT_URL=
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# Temporary D1 migration support.
# Local demo currently uses an in-process server store until production Supabase is configured.
D1_DATABASE_NAME=clan-arena-local
D1_STAGING_DATABASE_NAME=clan-arena-staging
D1_PRODUCTION_DATABASE_NAME=clan-arena-production
D1_DATABASE_ID=replace-with-local-or-staging-d1-id
D1_BINDING=DB

# Real auth is not configured until Supabase project credentials are provided.
AUTH_PROVIDER=supabase
ADMIN_EMAILS=admin@example.com

# Supabase Realtime and Storage are the target production providers.
REALTIME_PROVIDER=supabase-realtime
EVIDENCE_STORAGE_PROVIDER=supabase-storage
SUPABASE_STORAGE_BUCKET_AVATARS=avatars
SUPABASE_STORAGE_BUCKET_CLAN_EMBLEMS=clan-emblems
SUPABASE_STORAGE_BUCKET_TOURNAMENT_BANNERS=tournament-banners
SUPABASE_STORAGE_BUCKET_MATCH_EVIDENCE=match-evidence
SUPABASE_STORAGE_BUCKET_DISPUTE_EVIDENCE=dispute-evidence
SUPABASE_STORAGE_BUCKET_CLIPS=clips
SUPABASE_STORAGE_BUCKET_VENDOR_DELIVERIES=vendor-deliveries

# Wager controls stay demo-only until legal/payment approval.
WAGER_REAL_MONEY_ENABLED=false
DEMO_WALLET_STARTING_BALANCE=100
