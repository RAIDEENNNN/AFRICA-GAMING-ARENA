# Clan Arena local development
# Copy to .env.local when configuring real providers.

# Chosen backend path for this project: Cloudflare D1 through Drizzle.
# Local demo currently uses an in-process server store until a D1 binding exists.
DATABASE_PROVIDER=cloudflare-d1
D1_DATABASE_NAME=clan-arena-local
D1_STAGING_DATABASE_NAME=clan-arena-staging
D1_PRODUCTION_DATABASE_NAME=clan-arena-production
D1_DATABASE_ID=replace-with-local-or-staging-d1-id
D1_BINDING=DB

# Real auth is not configured yet. Sign in with ChatGPT helpers are present.
AUTH_PROVIDER=sign-in-with-chatgpt
ADMIN_EMAILS=admin@example.com

# Real-time and storage providers are intentionally unset until chosen.
REALTIME_PROVIDER=cloudflare-durable-objects
EVIDENCE_STORAGE_PROVIDER=cloudflare-r2
R2_BUCKET_NAME=clan-arena-evidence

# Wager controls stay demo-only until legal/payment approval.
WAGER_REAL_MONEY_ENABLED=false
DEMO_WALLET_STARTING_BALANCE=100
